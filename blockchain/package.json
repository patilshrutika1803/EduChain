{
  "name": "@educhain/blockchain",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "compile": "hardhat compile --config hardhat.config.cjs",
    "test": "hardhat test --config hardhat.config.cjs",
    "node": "hardhat node --config hardhat.config.cjs",
    "deploy:local": "hardhat run --network localhost --config hardhat.config.cjs scripts/deploy.cjs",
    "authorize-local-issuer": "hardhat run --network localhost --config hardhat.config.cjs scripts/authorize-local-issuer.cjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "hardhat": "^2.29.1"
  }
}
